import { Link, Divider, Value, fromAnyRef } from "../ui/components";
import { rul } from "../rul/Ruleset";
import { FC, Fragment, useMemo } from "react";

interface LinksListProps {
  items: any;
  cols?: number;
  vertical?: boolean;
  numberTable?: boolean;
  depth?: number;
  sorted?: boolean;
}

const LinksList: FC<LinksListProps> = ({
  items: initialItems,
  cols = 0,
  vertical = false,
  numberTable = false,
  depth = 2,
  sorted: sortedProp
}) => {
  
  // Handle sorted default
  const sorted = sortedProp ?? (initialItems?.length > 9);

  // Handle items transformation
  const items = (initialItems instanceof Set) ? [...initialItems] : initialItems;;

  // Create sorter function
  const sorter = sorted ? (a: any[]) => rul.sortStrings(a) : (a: any[]) => a;

  // Null check
  if (items == null) {
    return <>{rul.tr("NULL")}</>;
  }

  // Depth 0 check
  if (depth === 0) {
    return <>...</>;
  }

  // Columns layout
  if (cols) {
    return (
      <div className="cols" style={{ columns: cols }}>
        {items.map((field: any, i: number) => (
          <div key={i}>
            <Link href={field} />
          </div>
        ))}
      </div>
    );
  }

  // Number table layout
  if (numberTable) {
    return (
      <table className="number-table">
        <tbody>
          {Object.keys(items)
            .sort()
            .map((field, i) => (
              <tr key={i}>
                <td>
                  <Link href={field} />
                </td>
                <td>
                  <em>
                    <Link href={items[field]} />
                  </em>
                </td>
              </tr>
            ))}
        </tbody>
      </table>
    );
  }

  // Check for nested objects
  const hasNestedObjects = (Object.values(items) || []).some(
    (a) => typeof a === "object" && !fromAnyRef(a as any)
  );

  if (hasNestedObjects) {
    return (
      <>
        {Object.keys(items).map((subfield, j) => (
          <div key={subfield} className={j > 0 ? "top-border" : ""}>
            {!Array.isArray(items) && (
              <>
                <Value val={subfield} depth={depth - 1} /> :
              </>
            )}
            <div className="sublist">
              <Value val={items[subfield]} depth={depth - 1} />
            </div>
          </div>
        ))}
      </>
    );
  }

  // Items with no length property (object)
  if (items.length == null) {
    return (
      <span className="links-list">
        {sorter(Object.keys(items)).map((field: string, i: number) => (
          <Fragment key={field}>
            <Divider key={i} cols={cols} />
            <Value val={items[field]} depth={depth - 1} />&nbsp;
            <Link href={field} />
          </Fragment>
        ))}
      </span>
    );
  }

  // Items with map method (array)
  if (items.map) {
    return (
      <span className="links-list">
        {sorter(items.map((i: any) => i?.type || i)).map((item: any, i: number) => {
          if (Array.isArray(item)) {
            return (
              <div key={i} className="sublist">
                <LinksList items={item} depth={depth - 1} />
              </div>
            );
          }
          return (
            <Fragment key={i}>
              <Divider key={i} vertical={vertical} cols={cols} />
              <Link href={item} />
            </Fragment>
          );
        })}
      </span>
    );
  }

  // Debug fallback (console.warn instead of @debug)
  console.warn("Unexpected items structure:", items);
  return null;
};

export default LinksList;