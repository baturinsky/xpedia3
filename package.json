{
  "name": "xpedia3",
  "version": "3.0.0-alpha.9",
  "description": "OpenXCom reference engine",
  "main": "main.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "min": "vite build --mode=min",
    "cli": "vite build && node scripts/build-cli.mjs",
    "check": "tsc -p src/tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "node test/run.mjs",
    "export-gitlab": "npm run cli && node scripts/export-gitlab.mjs currentVersion"
  },
  "//pinned": "React, its renderer and the data grid are held at the versions the tables were written against. A caret range would pull React 19.3 and react-data-grid beta.64 on the next install, which is a large unrequested change to the section tables.",
  "//resolutions": "Security pins for dependencies we only pull in at build time. Each is the first version patched for an advisory; they stay inside the major the parent tool already asks for, so nothing downstream changes.",
  "resolutions": {
    "@babel/core": "^7.29.13",
    "baseline-browser-mapping": "^2.11.36",
    "browserslist": "^4.29.5",
    "esbuild": "0.27.2",
    "js-worker-search/uuid": "^11.1.1",
    "micromatch/picomatch": "^2.3.2",
    "nanoid": "^3.3.20",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.32",
    "rollup": "4.59.0",
    "source-map-js": "^1.2.2",
    "vite-plugin-top-level-await/uuid": "^11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "fflate": "^0.8.3",
    "js-yaml": "^4.3.2",
    "jszip": "^3.10.1",
    "node-unrar-js": "^2.0.2",
    "normalize.css": "^8.0.1",
    "react": "19.2.3",
    "react-data-grid": "7.0.0-beta.59",
    "react-dom": "19.2.3"
  }
}
